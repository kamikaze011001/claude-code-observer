{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*credentials*)",
      "Read(*secret*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(*.pem)",
      "Write(*.key)",
      "Write(CLAUDE.md)",
      "Write(.claude/settings.json)",
      "Write(.claude/rules/**)",
      "Write(.claude/hooks/**)",
      "Write(.github/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(git commit*--no-verify*)",
      "Bash(npx *)",
      "Bash(chmod 777*)",
      "Bash(npm publish*)",
      "Bash(python*-c *)",
      "Bash(node -e *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(eval *)",
      "mcp__*__delete*",
      "mcp__*__drop*",
      "mcp__*__exec*",
      "mcp__*__destroy*"
    ],
    "allow": [
      "Read(src/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(README.md)",
      "Read(.github/pull_request_template.md)",
      "Read(.env.example)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(docs/decisions/DECISION-LOG.md)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git checkout*)",
      "Write(package.json)",
      "Write(docs/**)",
      "Write(docs/decisions/ADR-*.md)",
      "mcp__*__write*",
      "mcp__*__create*",
      "mcp__*__send*",
      "mcp__*__update*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-command.py\""
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.py\""
          }
        ]
      }
    ]
  }
}
